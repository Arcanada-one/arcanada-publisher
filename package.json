{
  "name": "arcanada-publisher",
  "version": "0.1.0-pre.0",
  "private": true,
  "description": "OSS browser publisher (Facebook / LinkedIn / X / Reddit / VK) — Playwright + agent-callable CLI/HTTP",
  "license": "MIT",
  "type": "module",
  "homepage": "https://arcanada.one/publisher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcanada-one/arcanada-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/Arcanada-one/arcanada-publisher/issues"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "pnpm -r lint && prettier --check \"**/*.{ts,md,json,yml,yaml}\"",
    "typecheck": "tsc --build",
    "audit": "npx --yes pnpm@11.13.1 with 11.13.1 audit --prod --audit-level=high",
    "format": "prettier --write \"**/*.{ts,md,json,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
