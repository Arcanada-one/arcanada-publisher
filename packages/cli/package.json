{
  "name": "@arcanada/publisher",
  "version": "0.1.0-pre.0",
  "description": "Unified CLI for arcanada-publisher",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "arcanada-publisher": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint --no-error-on-unmatched-pattern src tests"
  },
  "dependencies": {
    "@arcanada/publisher-core": "workspace:*",
    "@arcanada/publisher-server": "workspace:*",
    "@arcanada/publisher-facebook": "workspace:*",
    "@arcanada/publisher-linkedin": "workspace:*",
    "@arcanada/publisher-x": "workspace:*",
    "@arcanada/publisher-reddit": "workspace:*",
    "@arcanada/publisher-vkontakte": "workspace:*",
    "@arcanada/publisher-video": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
