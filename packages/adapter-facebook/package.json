{
  "name": "@arcanada/publisher-facebook",
  "version": "0.1.0-pre.0",
  "description": "Facebook adapter for arcanada-publisher (Playwright + persistent profile).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:smoke": "vitest run tests/smoke.spec.ts",
    "lint": "eslint --no-error-on-unmatched-pattern src tests"
  },
  "dependencies": {
    "@arcanada/publisher-core": "workspace:*",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.1"
  }
}
