{
  "name": "@arcanada/publisher-vkontakte",
  "version": "0.1.0-pre.0",
  "description": "VKontakte adapter for arcanada-publisher (VK API)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint --no-error-on-unmatched-pattern src tests"
  },
  "dependencies": {
    "@arcanada/publisher-core": "workspace:*",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
